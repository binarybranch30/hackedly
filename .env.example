# Copy to .env and fill in. NEVER commit .env.
GEMINI_API_KEY=

# Which model backend to use: gemini | ollama | fake
MODEL_BACKEND=fake
GEMINI_MODEL=gemma-4-31b-it
OLLAMA_MODEL=gemma4:e2b
OLLAMA_URL=http://localhost:11434

# If Gemini keeps returning 429 after backoff, switch to Ollama automatically
AUTO_FALLBACK=true
