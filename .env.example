# Copy to .env and fill in. NEVER commit .env.
GEMINI_API_KEY=

# Which model backend to use: gemini | ollama | fake
MODEL_BACKEND=fake
# Gemma 4 on the Gemini API. Measured on 2026-10-09: gemma-4-26b-a4b-it answered in ~1s,
# gemma-4-31b-it took ~30-60s per call and often returned 503 "high demand".
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODEL=gemma-4-31b-it
GEMMA_THINKING=minimal
OLLAMA_MODEL=gemma4:e2b
OLLAMA_URL=http://localhost:11434

# If Gemini keeps returning 429 after backoff, switch to Ollama automatically
AUTO_FALLBACK=false
HACKEDLY_DEMO=false   # true: a fresh deployment opens on the sample class
